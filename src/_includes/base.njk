<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{% set journalHome = page.url == "/" %}
{% set pageTitle = seoTitle or title %}
{% set pageDescription = description or "Technical notes, project updates, infrastructure logs, experiments, and development posts from calibexs." %}
{% set canonicalUrl = "https://calibexs.com/journal" + page.url %}

{% if journalHome %}
<title>technical journal & project logs — calibexs</title>
{% else %}
<title>{{ pageTitle }} — calibexs journal</title>
{% endif %}

<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="calibexs">
<meta name="theme-color" content="#7c3aed">

<link rel="canonical" href="{{ canonicalUrl }}">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<meta property="og:site_name" content="calibexs">

{% if journalHome %}
<meta property="og:title" content="technical journal & project logs — calibexs">
{% else %}
<meta property="og:title" content="{{ pageTitle }} — calibexs journal">
{% endif %}

<meta property="og:description" content="{{ pageDescription }}">

{% if isPost %}
<meta property="og:type" content="article">
<meta property="article:published_time" content="{{ date | isoDate }}">
{% else %}
<meta property="og:type" content="website">
{% endif %}

<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:image" content="https://calibexs.com/preview.svg">
<meta property="og:image:alt" content="calibexs">

{% if isPost %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ pageTitle | json | safe }},
  "description": {{ pageDescription | json | safe }},
  "datePublished": {{ date | isoDate | json | safe }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ canonicalUrl | json | safe }}
  },
  "author": {
    "@type": "Person",
    "name": "calibexs",
    "url": "https://calibexs.com/"
  }
}
</script>
{% endif %}

<style>

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#05010a;
  color:#f5f3ff;
  line-height:1.8;
}

main{
  max-width:900px;
  margin:auto;
  padding:70px 28px;
}

a{
  color:#c084fc;
  text-decoration:none;
}

a:hover{
  color:#f5d0fe;
}

.home{
  display:inline-block;
  margin-bottom:70px;
  color:#c084fc;
  font-size:18px;
}

h1{
  font-size:clamp(48px,9vw,82px);
  line-height:1;
  letter-spacing:-3px;
  margin:0 0 28px;
}

p{
  font-size:20px;
}

.card{
  display:block;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:28px;
  padding:30px;
  margin:22px 0;
  color:inherit;
}

.card:hover{
  border-color:rgba(168,85,247,.35);
}

.date{
  color:#a78bfa;
  font-size:15px;
  margin-bottom:18px;
}

</style>
</head>

<body>

<main>

{% if journalHome %}
  <a class="home" href="/">← home</a>
{% else %}
  <a class="home" href="/journal/">← back to journal</a>
{% endif %}

{{ content | safe }}

</main>

</body>
</html>
