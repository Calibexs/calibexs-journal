<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{% set journalHome = page.url == "/" %}
{% set pageTitle = seoTitle or title %}
{% set pageDescription = description or "Technical notes, project updates, infrastructure logs, experiments, and development posts from calibexs." %}
{% set canonicalUrl = "https://calibexs.com/journal" + page.url %}

{% if journalHome %}
<title>technical journal & project logs — calibexs</title>
{% else %}
<title>{{ pageTitle }} — calibexs journal</title>
{% endif %}

<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="calibexs">
<meta name="theme-color" content="#7c3aed">

<link rel="canonical" href="{{ canonicalUrl }}">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<meta property="og:site_name" content="calibexs">

{% if journalHome %}
<meta property="og:title" content="technical journal & project logs — calibexs">
{% else %}
<meta property="og:title" content="{{ pageTitle }} — calibexs journal">
{% endif %}

<meta property="og:description" content="{{ pageDescription }}">

{% if isPost %}
<meta property="og:type" content="article">
<meta property="article:published_time" content="{{ date | isoDate }}">
{% else %}
<meta property="og:type" content="website">
{% endif %}

<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:image" content="https://calibexs.com/preview.png">
<meta property="og:image:alt" content="calibexs">

{% if isPost %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ pageTitle | json | safe }},
  "description": {{ pageDescription | json | safe }},
  "datePublished": {{ date | isoDate | json | safe }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ canonicalUrl | json | safe }}
  },
  "author": {
    "@type": "Person",
    "name": "calibexs",
    "url": "https://calibexs.com/"
  }
}
</script>
{% endif %}

<style>

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#05010a;
  color:#f5f3ff;
  line-height:1.8;
}

main{
  max-width:900px;
  margin:auto;
  padding:70px 28px;
}

a{
  color:#c084fc;
  text-decoration:none;
}

a:hover{
  color:#f5d0fe;
}

.home{
  display:inline-block;
  margin-bottom:70px;
  color:#c084fc;
  font-size:18px;
}

h1{
  font-size:clamp(48px,9vw,82px);
  line-height:1;
  letter-spacing:-3px;
  margin:0 0 28px;
}

p{
  font-size:20px;
}

.card{
  display:block;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:28px;
  padding:30px;
  margin:22px 0;
  color:inherit;
}

.card:hover{
  border-color:rgba(168,85,247,.35);
}

.date{
  color:#a78bfa;
  font-size:15px;
  margin-bottom:18px;
}


/* CALIBEXS JOURNAL VISUAL REFRESH */
:root {
  color-scheme: dark;
}

body {
  background:
    radial-gradient(ellipse at 8% 12%,
      rgba(112,35,164,.13), transparent 38%),
    radial-gradient(ellipse at 95% 65%,
      rgba(99,54,180,.08), transparent 45%),
    #07030d;
  color: #f3eefa;
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.65;
}

main {
  max-width: 1180px;
  padding: 42px 28px 90px;
}

main > [data-cx-navigation] {
  margin-bottom: 76px;
}

h1 {
  font-size: clamp(54px, 8vw, 112px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -.065em;
  margin-bottom: 22px;
  background: linear-gradient(100deg,
    #e8b9ff 0%, #c58afa 50%, #8980ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

main > p {
  max-width: 760px;
  color: #bfaad9;
  font-size: clamp(16px, 1.7vw, 19px);
  line-height: 1.7;
  margin-bottom: 35px;
}

.card {
  display: block;
  background: rgba(19,13,27,.88);
  border: 1px solid rgba(210,174,240,.11);
  border-radius: 25px;
  padding: 28px 30px;
  margin: 16px 0;
  color: #f3eefa;
  transition:
    transform .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.card:hover {
  transform: translateY(-3px);
  border-color: rgba(168,85,247,.43);
  box-shadow: 0 12px 35px rgba(75,25,115,.14);
  color: #fff;
}

.card h2, .card h3 {
  line-height: 1.3;
  letter-spacing: -.025em;
  margin: 12px 0;
}

.card p {
  font-size: 15px;
  color: #bda9d8;
  line-height: 1.7;
  margin: 10px 0;
}

.date {
  color: #c79af0;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .02em;
  margin-bottom: 12px;
}

a { color: #c69af8; }

@media(max-width:700px) {
  main { padding: 24px 20px 65px; }
  main > [data-cx-navigation] {
    margin-bottom: 48px;
  }
  h1 { letter-spacing: -.05em; }
  .card { padding: 22px; border-radius: 20px; }
}


/* CALIBEXS JOURNAL PAGINATION */
.cx-pagination {
  display:flex;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  gap:10px;
  margin:40px auto 10px;
}
.cx-pagination:empty { display:none; }
.cx-pagination a {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:42px;
  padding:10px 15px;
  background:rgba(255,255,255,.025);
  border:1px solid rgba(255,255,255,.1);
  border-radius:999px;
  color:#e7d7f7;
  font-size:13px;
  text-decoration:none;
}
.cx-pagination a:hover {
  border-color:rgba(168,85,247,.45);
  background:rgba(168,85,247,.12);
}
.cx-pagination a[aria-current="page"] {
  color:#d6abff;
  font-weight:700;
  border-color:rgba(168,85,247,.5);
  background:rgba(168,85,247,.15);
}

</style>
<link rel="stylesheet" href="/shared-calibexs/navigation.css?v=1">
</head>

<body>

<main>

{% if journalHome %}
  <nav data-cx-navigation aria-label="Main navigation"></nav>
{% else %}
  <a class="home" href="/journal/">← back to journal</a>
{% endif %}

{{ content | safe }}

</main>

<script src="/shared-calibexs/navigation.js?v=1" defer></script>
</body>
</html>
