<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{{ title }} — calibexs journal</title>

<meta name="theme-color" content="#7c3aed">

<meta
  name="description"
  content="{{ description or 'calibexs journal — notes, updates, projects, logs, and random posts.' }}"
>

<meta
  name="keywords"
  content="calibexs, journal, blog, urbex, cars, servers, projects"
>

<meta name="author" content="calibexs">

<meta property="og:title" content="{{ title }} — calibexs journal">

<meta
  property="og:description"
  content="{{ description or 'calibexs journal — notes, updates, projects, logs, and random posts.' }}"
>

<meta property="og:type" content="article">

<meta
  property="og:url"
  content="https://calibexs.com{{ page.url }}"
>

<meta
  property="og:image"
  content="https://calibexs.com/preview.svg"
>

<meta name="twitter:card" content="summary_large_image">

<meta
  name="twitter:title"
  content="{{ title }} — calibexs journal"
>

<meta
  name="twitter:description"
  content="{{ description or 'calibexs journal — notes, updates, projects, logs, and random posts.' }}"
>

<meta
  name="twitter:image"
  content="https://calibexs.com/preview.svg"
>

<link
  rel="icon"
  type="image/svg+xml"
  href="https://calibexs.com/favicon.svg"
>

<link
  rel="shortcut icon"
  href="https://calibexs.com/favicon.svg"
>

<style>

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#05010a;
  color:#f5f3ff;
  line-height:1.8;
}

main{
  max-width:900px;
  margin:auto;
  padding:70px 28px;
}

a{
  color:#c084fc;
  text-decoration:none;
}

a:hover{
  color:#f5d0fe;
}

.home{
  display:inline-block;
  margin-bottom:70px;
  color:#c084fc;
  font-size:18px;
}

h1{
  font-size:clamp(48px,9vw,82px);
  line-height:1;
  letter-spacing:-3px;
  margin:0 0 28px;
}

p{
  font-size:20px;
}

.card{
  display:block;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:28px;
  padding:30px;
  margin:22px 0;
  color:inherit;
}

.card:hover{
  border-color:rgba(168,85,247,.35);
}

.date{
  color:#a78bfa;
  font-size:15px;
  margin-bottom:18px;
}

</style>
</head>

<body>

<main>

{% if title == "journal" %}
  <a class="home" href="/">← home</a>
{% else %}
  <a class="home" href="/journal/">← back to journal</a>
{% endif %}

{{ content | safe }}

</main>

</body>
</html>
